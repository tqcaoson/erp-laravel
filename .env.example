# File cấu hình mẫu cho hệ thống ERP — copy thành .env rồi chạy Docker.
# Xem hướng dẫn chi tiết trong README.md.

APP_NAME=ERP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Log ra stderr theo chuẩn Docker (xem bằng docker compose logs).
LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- MySQL (service "mysql" trong docker-compose) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erp
DB_USERNAME=erp_user
DB_PASSWORD=change_me_strong
DB_ROOT_PASSWORD=change_me_root

# --- Redis (service "redis"): cache + session + queue ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (mặc định ghi log, đổi sang smtp khi có mail server thật) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="erp@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cổng nginx trên máy host (đổi thành 8081 nếu cổng 80 đã bận).
NGINX_PORT=80

VITE_APP_NAME="${APP_NAME}"
